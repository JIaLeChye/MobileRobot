[Unit]
Description=Mobile Robot Code Updater Service
After=network-online.target
Wants=network-online.target


[Service]
Type=oneshot
User=vboxuser
Environment=MCUPDATER_LOG_DIR=/home/vboxuser/Debug_log
WorkingDirectory=/home/vboxuser/Desktop/MobileRobot/RepoUpdater
ExecStart=/usr/bin/python3 /home/vboxuser/Desktop/MobileRobot/RepoUpdater/updater.py --service
# Default to journald; setup.sh will overwrite with Debug_log log files
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
TimeoutStopSec=30
KillMode=mixed
Restart=on-failure
RestartSec=60
StartLimitInterval=3600
StartLimitBurst=5
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target