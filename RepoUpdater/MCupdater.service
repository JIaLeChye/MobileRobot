[Unit]
Description=Mobile Robot Code Updater Service
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target


[Service]
Type=oneshot
User=rpirobot
Environment=MCUPDATER_LOG_DIR=/path/to/Debug_log
WorkingDirectory=/path/to/Desktop/MobileRobot/RepoUpdater
ExecStart=/usr/bin/python3 /path/to/Desktop/MobileRobot/RepoUpdater/updater.py --service
# Default to journald; setup.sh will overwrite with Debug_log log files
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
TimeoutStopSec=30
KillMode=mixed
Restart=on-failure
RestartSec=60
StartLimitInterval=3600
StartLimitBurst=5
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target